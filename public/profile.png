<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 800" width="600" height="800">
  <defs>
    <!-- Background Sandstone Wall Gradients -->
    <linearGradient id="wallBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#dbcaa8"/>
      <stop offset="50%" stop-color="#cbb592"/>
      <stop offset="100%" stop-color="#b8a07c"/>
    </linearGradient>
    <linearGradient id="wallShadow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#000000" stop-opacity="0.15"/>
      <stop offset="40%" stop-color="#000000" stop-opacity="0.0"/>
      <stop offset="80%" stop-color="#000000" stop-opacity="0.25"/>
    </linearGradient>

    <!-- Linen Shirt Gradients -->
    <linearGradient id="shirtGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f7f0d8"/>
      <stop offset="50%" stop-color="#ebdcb4"/>
      <stop offset="100%" stop-color="#d9c79c"/>
    </linearGradient>
    <linearGradient id="shirtShadow" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#c4b085"/>
      <stop offset="100%" stop-color="#a89368"/>
    </linearGradient>

    <!-- Skin Tones (Golden Tan South Asian) -->
    <linearGradient id="skinBase" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#c48e65"/>
      <stop offset="60%" stop-color="#aa734b"/>
      <stop offset="100%" stop-color="#88522d"/>
    </linearGradient>
    <linearGradient id="skinHighlight" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#d9a37a"/>
      <stop offset="100%" stop-color="#aa734b"/>
    </linearGradient>

    <!-- Sunglasses Dark Lens & Frame -->
    <linearGradient id="sunglassLens" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
    <linearGradient id="sunglassGlare" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.3"/>
      <stop offset="50%" stop-color="#ffffff" stop-opacity="0.05"/>
    </linearGradient>

    <!-- Gold Watch / Bracelet -->
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a"/>
      <stop offset="50%" stop-color="#eab308"/>
      <stop offset="100%" stop-color="#854d0e"/>
    </linearGradient>

    <!-- Soft Drop Shadows -->
    <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="4" dy="12" stdDeviation="16" flood-color="#1e130a" flood-opacity="0.35"/>
    </filter>
    <filter id="gentleShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="2" dy="6" stdDeviation="6" flood-color="#000000" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Background Sandstone Wall -->
  <rect width="600" height="800" fill="url(#wallBg)"/>
  
  <!-- Horizontal Stone Slab Joint Lines -->
  <line x1="0" y1="210" x2="600" y2="210" stroke="#9e8767" stroke-width="3" opacity="0.6"/>
  <line x1="0" y1="480" x2="600" y2="480" stroke="#9e8767" stroke-width="3" opacity="0.6"/>
  <rect width="600" height="800" fill="url(#wallShadow)"/>

  <!-- Main Figure Group -->
  <g filter="url(#softShadow)">

    <!-- Leaning Arm & Body Shadow on Wall -->
    <path d="M 420 310 C 470 380, 520 500, 540 800 L 380 800 C 370 650, 360 520, 380 430 Z" fill="#7a6245" opacity="0.3"/>

    <!-- Right Arm (leaning against wall, hand resting) -->
    <path d="M 410 320 C 460 380, 500 480, 530 650 C 510 670, 480 660, 460 610 C 430 520, 400 420, 380 350 Z" fill="url(#shirtGrad)"/>
    <!-- Folded Sleeve Cuff Right -->
    <path d="M 465 570 C 485 580, 510 590, 525 610 C 515 630, 480 625, 460 600 Z" fill="url(#shirtShadow)"/>
    <!-- Forearm Right Skin -->
    <path d="M 485 610 C 510 650, 520 720, 530 800 L 480 800 C 470 740, 460 680, 455 630 Z" fill="url(#skinBase)"/>
    <!-- Gold Watch / Bracelet on Right Wrist -->
    <rect x="470" y="730" width="45" height="18" rx="4" fill="url(#goldGrad)" transform="rotate(-15 492 739)"/>

    <!-- Left Arm & Torso (Hand in pocket) -->
    <path d="M 120 800 C 130 680, 150 560, 190 420 C 210 350, 240 310, 280 300 L 390 320 C 410 380, 420 480, 410 800 Z" fill="url(#shirtGrad)"/>
    
    <!-- Left Forearm & Hand in Pocket -->
    <path d="M 170 540 C 200 600, 250 680, 290 730 L 260 760 C 220 700, 170 620, 140 550 Z" fill="url(#shirtGrad)"/>
    <path d="M 270 700 C 310 740, 330 770, 335 800 L 290 800 C 275 770, 250 740, 235 710 Z" fill="url(#skinBase)"/>

    <!-- Shirt Details: Collar, Placket & Buttons -->
    <!-- Open Collar V -->
    <path d="M 280 290 L 310 380 L 340 290 Z" fill="#d9c79c"/>
    <path d="M 270 280 L 290 350 L 310 290 Z" fill="url(#shirtShadow)"/>
    <path d="M 350 280 L 330 350 L 310 290 Z" fill="url(#shirtShadow)"/>

    <!-- Placket Center Line -->
    <path d="M 310 380 L 320 800" stroke="#b39d73" stroke-width="3"/>

    <!-- Prominent Black Buttons (Exact matching attached photo) -->
    <circle cx="308" cy="355" r="6" fill="#0f172a" stroke="#d9c79c" stroke-width="1.5"/>
    <circle cx="310" cy="425" r="6.5" fill="#0f172a"/>
    <circle cx="312" cy="495" r="6.5" fill="#0f172a"/>
    <circle cx="314" cy="565" r="6.5" fill="#0f172a"/>
    <circle cx="316" cy="635" r="6.5" fill="#0f172a"/>
    <circle cx="318" cy="705" r="6.5" fill="#0f172a"/>

    <!-- Neck -->
    <path d="M 275 250 C 275 310, 345 310, 345 250 Z" fill="url(#skinHighlight)"/>
    <path d="M 285 270 C 300 305, 330 305, 335 270 Z" fill="#88522d" opacity="0.4"/>

    <!-- Head & Face Structure -->
    <path d="M 240 160 C 235 260, 380 260, 375 160 C 375 100, 240 100, 240 160 Z" fill="url(#skinBase)"/>

    <!-- Groomed Beard & Goatee & Mustache -->
    <!-- Jawline Beard -->
    <path d="M 242 180 C 240 255, 370 255, 370 180 C 362 268, 250 268, 242 180 Z" fill="#14100e"/>
    <!-- Mustache -->
    <path d="M 275 212 Q 306 222 338 212 Q 306 202 275 212 Z" fill="#14100e"/>
    <!-- Chin Beard Patch -->
    <path d="M 292 225 C 292 250, 320 250, 320 225 Z" fill="#14100e"/>

    <!-- Ears -->
    <ellipse cx="238" cy="175" rx="8" ry="14" fill="url(#skinBase)"/>
    <ellipse cx="374" cy="172" rx="8" ry="14" fill="url(#skinBase)"/>

    <!-- Stylish Black Sunglasses (Matching attached photo wayfarer style) -->
    <g filter="url(#gentleShadow)">
      <!-- Left Lens Frame -->
      <rect x="245" y="142" width="58" height="38" rx="8" fill="url(#sunglassLens)" stroke="#090d16" stroke-width="3.5"/>
      <!-- Right Lens Frame -->
      <rect x="312" y="140" width="58" height="38" rx="8" fill="url(#sunglassLens)" stroke="#090d16" stroke-width="3.5"/>
      <!-- Bridge -->
      <rect x="298" y="148" width="18" height="5" rx="2" fill="#090d16"/>
      <!-- Temple Arms -->
      <path d="M 245 150 L 235 152" stroke="#090d16" stroke-width="4"/>
      <path d="M 370 148 L 380 150" stroke="#090d16" stroke-width="4"/>
      <!-- Lens Glare Reflection -->
      <polygon points="252,146 278,146 262,174 252,174" fill="url(#sunglassGlare)"/>
      <polygon points="319,144 345,144 329,172 319,172" fill="url(#sunglassGlare)"/>
    </g>

    <!-- Voluminous Styled Dark Curly Hair (Exact hairstyle from photo) -->
    <!-- Base Hair Mass -->
    <path d="M 220 145 C 210 50, 270 10, 310 10 C 360 10, 400 50, 390 145 C 375 100, 350 55, 308 55 C 265 55, 238 100, 220 145 Z" fill="#0e0a08"/>
    <!-- Top Hair Volume & Waves/Curls -->
    <path d="M 230 110 C 220 30, 280 12, 310 12 C 350 12, 390 30, 380 110 C 360 60, 340 32, 310 32 C 275 32, 250 60, 230 110 Z" fill="#1a1410"/>
    <path d="M 250 80 C 240 25, 290 15, 315 15 C 345 15, 375 25, 365 80 C 350 42, 330 25, 310 25 C 285 25, 265 42, 250 80 Z" fill="#2d221c"/>
    <!-- Side Fades -->
    <path d="M 230 150 C 225 120, 238 100, 245 90 C 235 110, 232 130, 232 150 Z" fill="#14100e"/>
    <path d="M 380 150 C 385 120, 372 100, 365 90 C 375 110, 378 130, 378 150 Z" fill="#14100e"/>

  </g>

  <!-- Overlay Name Tag Badge -->
  <g filter="url(#gentleShadow)">
    <rect x="180" y="725" width="240" height="42" rx="14" fill="#090d16" opacity="0.92" stroke="#3b82f6" stroke-width="1.5"/>
    <text x="300" y="752" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="800" font-size="15" fill="#ffffff" text-anchor="middle" letter-spacing="2.5">SABARI M</text>
  </g>
</svg>
